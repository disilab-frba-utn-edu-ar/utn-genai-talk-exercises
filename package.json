{
  "name": "mentorias-a-voluntad",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Mentorías a Voluntad: colectivos reservan sesiones con personas mentoras que donan horas de asesoramiento.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "predev": "node scripts/seed.mjs --si-falta",
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "prestart": "node scripts/seed.mjs --si-falta",
    "start": "tsx server/index.ts",
    "seed": "node scripts/seed.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "logs:resumen": "node scripts/agent-logs/resumen.mjs",
    "logs:timeline": "node scripts/agent-logs/resumen.mjs --timeline",
    "logs:limpiar": "node -e \"require('fs').rmSync('logs/agent-actions.jsonl',{force:true})\""
  },
  "dependencies": {
    "express": "^5.3.0",
    "marked": "^18.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
